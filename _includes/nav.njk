<div style="display: flex; flex-direction: row; border-bottom: 1px solid #cfcfcf; background-color: white; justify-content: space-evenly; align-items: center; padding: 20px 0 20px 0;">

  <a href="/" style="text-decoration: none;">
    <img src="/img/logo.png" alt="Logo iPhoneShop">
  </a>

  <a class="WhatsAppButton desktop" href="https://api.whatsapp.com/send/?phone=57350324894&text&type=phone_number&app_absent=0">
    <img src="/img/icono_apple.png" alt="WhatsApp">
    <span>Chatea con nosotros</span>
  </a>

  <a href="/productos" class="desktop">Productos</a>
  <a href="/servicios" class="desktop">Servicios</a>
  <a href="/nosotros" class="desktop">Sobre Nosotros</a>

  <button style="border: none; background: none; cursor: pointer;" onclick="window.location = '/productos/carrito'">
    <img class="w-box c10ddvei c1qrwpo0 iconify" src="{% icon 'shopping-bag-4-fill', '948FC' %}" alt="Carrito">
  </button>

  <button class="mobile none" data-modal-id="NavModal">
    <img class="w-box c10ddvei c1qrwpo0 iconify" src="{% icon 'menu-fill' %}" alt="Menú">
  </button>
</div>

{% css %}
  #ModalOverlay {
    background-color: rgba(0 0 0 / 0.2);
    position: fixed;
    top: 0;
    left: 0;
    height: 100dvh;
    width: 100vw;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }
  #ModalOverlay[data-active="false"] { display: none; }
  #ModalOverlay[data-active="true"] { display: flex; }

  #ModalOverlay[data-active="true"] + * {
    pointer-events: none;
  }

  .modal {
    border-radius: 30px;
    background-color: white;
    flex-direction: column;
		position: relative;
  }
  .modal[data-active="false"] { display: none; }
  .modal[data-active="true"] { display: flex; }

  .modal img.iconify {
    width: 18px;
    top: 17px;
    position: absolute;
    right: 20px;
  }

  .modal#NavModal {
    gap: 10px;
    z-index: 50;
  }
  .modal#NavModal a {
    font-size: 15px;
  }
  .modal#NavModal hr {
    width: 100%;
    opacity: 13%;
    border: 1px black solid;
  }

  .Toast {
    background-color: #9ee089;
    width: 20vw;
    min-height: 5vh;
    position: fixed;
    bottom: 0;
    right: 0;
		margin: 10px;
    border-radius: 10px;
    padding: 10px;
  }

  .Toast[data-active="false"] { display: none; }
{% endcss %}

<div id="ModalOverlay" data-active="false">
  <div class="modal" id="NavModal" data-active="false" style="padding: 30px">
    <img class="w-box c10ddvei c1qrwpo0 iconify x" src="{% icon 'close-large-fill' %}" alt="Cerrar">
    <h2>¿A dónde vamos?</h2>
    <hr>
    <a href="/">Inicio</a>
    <hr>
    <a href="/productos">Productos</a>
    <hr>
    <a href="/servicios">Servicios</a>
    <hr>
    <a href="/nosotros">Sobre Nosotros</a>
  </div>
</div>

<div id="Success" class="Toast" data-active="false">
  Producto agregado exitosamente!
</div>

{% js %}
  window.cflabs = window.cflabs || {};
  window.cflabs.msjsRandom = [
    "Hola! Quiero unirme al parche de las segundas oportunidades! 😎",
    "Hola! Quiero preguntar si tienen un producto disponible 🤔💭",
    "Buenas, quería llevar mi celular y que me asesoren para repararlo 🛠",
    "Buenas, quiero comprar un iPhone nuevo con mi iPhone viejo 📱✨"
  ];

  window.cflabs.whatsAppURL = `https://api.whatsapp.com/send/?phone=573503324894&text=${encodeURIComponent(window.cflabs.msjsRandom[Math.floor(Math.random() * window.cflabs.msjsRandom.length)])}`;

  // ----------------------------------------------------------------------

  // Modal toggle functionality
  document.querySelectorAll("[data-modal-id]").forEach(mt => {
    mt.addEventListener("click", () => {
      const modal = document.querySelector(`#${mt.dataset.modalId}`);
      const modalOverlay = document.querySelector('#ModalOverlay');

      modal.dataset.active = modal.dataset.active === 'true' ? 'false' : 'true';
      modalOverlay.dataset.active = modalOverlay.dataset.active === 'true' ? 'false' : 'true';
    });
  });

  // Modal close functionality
  document.querySelectorAll(".modal .iconify.x").forEach(closeBtn => {
    closeBtn.addEventListener("click", () => {
      const modal = closeBtn.closest('.modal');
      const modalOverlay = document.querySelector('#ModalOverlay');

      modal.dataset.active = 'false';
      modalOverlay.dataset.active = 'false';
    });
  });

  const toggleToast = (id, timeout = 3000) => {
    const toast = document.querySelector(`#${id}`);

    toast.dataset.active = toast.dataset.active === 'true' ? 'false' : 'true';

		setTimeout(() => {
    	toast.dataset.active = false;
		}, timeout)
	}

  if (window.cflabs.utils) {
    window.cflabs.utils.toggleToast = toggleToast
  } else {
    window.cflabs.utils = {}
    window.cflabs.utils.toggleToast = toggleToast
  }
{% endjs %}
